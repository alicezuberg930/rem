spring.config.import=optional:file:../.env[.properties]
# DB variables
spring.application.name=rem
spring.datasource.url=jdbc:mysql://localhost:3306/rem_db
spring.datasource.username=rem123
spring.datasource.password=123456
# Database schema management
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migrations
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
spring.flyway.validate-on-migrate=true
# Global prefix
server.servlet.context-path=/api/v1
# jwt
jwt.access_token_secret=
jwt.refresh_token_secret=
jwt.access_token_expiration=3600
jwt.refresh_token_expiration=604800
# Gmail variables
spring.mail.host=
spring.mail.port=
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
# Twilio variables
twilio.account-sid=
twilio.auth-token=
twilio.phone-number=
# Vonage variables
vonage.api-secret=
vonage.api-key=
vonage.from=
# cloudinary
cloudinary.cloud-name=
cloudinary.api-key=
cloudinary.api-secret=
cloudinary.base-folder=rem-app
# resend
resend.api-key=
resend.email=
# web push notifications
notification.web-push-public-key=
notification.web-push-private-key=
notification.web-push-subject=
# MinIO object storage
minio.endpoint=${MINIO_ENDPOINT:http://localhost:9000}
minio.public-endpoint=${MINIO_PUBLIC_ENDPOINT:${MINIO_ENDPOINT:http://localhost:9000}}
minio.access-key=${MINIO_ACCESS_KEY:${MINIO_ROOT_USER:admin}}
minio.secret-key=${MINIO_SECRET_KEY:${MINIO_ROOT_PASSWORD:minioadmin}}
minio.bucket=${MINIO_BUCKET:rem-storage}
minio.upload-url-expiry-seconds=${MINIO_UPLOAD_URL_EXPIRY_SECONDS:900}
minio.download-url-expiry-seconds=${MINIO_DOWNLOAD_URL_EXPIRY_SECONDS:900}
minio.share-url-expiry-seconds=${MINIO_SHARE_URL_EXPIRY_SECONDS:86400}
